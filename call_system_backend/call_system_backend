"""
generate_training_data.py
─────────────────────────
Phase 2 — Synthetic multilingual call data generator.
Uses your already-running Ollama (llama3.1) to create training samples
in all 6 language variants your call centre handles.

Usage:
    python generate_training_data.py
    python generate_training_data.py --samples 200 --output data/train.jsonl
"""

from __future__ import annotations
import json
import argparse
import logging
import random
import time
from pathlib import Path

import ollama

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
log = logging.getLogger("datagen")

OLLAMA_MODEL = "llama3.1"

# ── Language variants your call centre handles ────────────────────────────────
LANGUAGE_VARIANTS = [
    "English",
    "Hindi",
    "Marathi",
    "Kannada",
    "Hinglish (mix of Hindi and English in same sentence)",
    "Marathi-English mix (Marathi sentences with English technical words)",
]

# ── Real-world CRM issues your agents deal with ───────────────────────────────
ISSUE_CATEGORIES = [
    "billing dispute or overcharge",
    "internet not working or slow speed",
    "mobile SIM not working",
    "wrong product delivered",
    "refund not received",
    "app login not working",
    "OTP not received",
    "account blocked or frozen",
    "DTH or cable TV signal issue",
    "delivery delayed",
    "product damaged on arrival",
    "subscription cancellation request",
    "recharge not reflected",
    "EMI or loan payment issue",
    "KYC document verification pending",
]

# ── Sentiment distribution (realistic: mostly negative in support calls) ──────
SENTIMENTS = {
    "negative": 0.55,   # frustrated, angry customers
    "neutral":  0.25,   # calm, just asking
    "positive": 0.20,   # happy, resolved call
}

SENTIMENT_MOODS = {
    "negative": ["very frustrated", "angry", "irritated", "upset", "complaining loudly"],
    "neutral":  ["calm", "polite", "matter-of-fact", "patient"],
    "positive": ["happy", "satisfied", "grateful", "relieved after resolution"],
}


def pick_sentiment() -> str:
    r = random.random()
    cumulative = 0.0
    for label, prob in SENTIMENTS.items():
        cumulative += prob
        if r < cumulative:
            return label
    return "neutral"


def build_prompt(language: str, issue: str, sentiment: str, mood: str) -> str:
    return f"""You are generating synthetic customer support call data for fine-tuning an AI model.

Generate a realistic customer support call transcript and its analysis.

Requirements:
- Language: {language}
- Customer issue: {issue}
- Customer sentiment: {sentiment} ({mood})
- The call should be 6-12 exchanges between AGENT and CUSTOMER
- Agent should be professional, empathetic, solution-focused
- Include realistic Indian names, phone numbers, city names (Mumbai, Pune, Bangalore, etc.)
- For mixed languages, naturally switch mid-sentence like real speakers do

Respond ONLY with a valid JSON object. No markdown. No extra text. Keys:
- "language": the language variant used
- "issue_category": short category name
- "transcript": array of objects with "role" (AGENT or CUSTOMER) and "text"
- "customer_text": all customer lines joined as one string
- "agent_text": all agent lines joined as one string  
- "issue_title": 5-8 word summary of the issue
- "summary": 2-3 sentence summary of what happened in the call
- "sentiment": one of: positive / neutral / negative
- "resolution": one of: resolved / unresolved / escalated
- "call_duration_seconds": realistic integer between 90 and 480

JSON:"""


def generate_one_sample(language: str, issue: str, sentiment: str) -> dict | None:
    mood = random.choice(SENTIMENT_MOODS[sentiment])
    prompt = build_prompt(language, issue, sentiment, mood)

    try:
        response = ollama.generate(
            model=OLLAMA_MODEL,
            prompt=prompt,
            options={
                "temperature": 0.85,
                "num_predict": 1200,
                "stop": ["\n\n\n"],
            },
        )
        raw = response["response"].strip()

        # Strip accidental markdown fences
        raw = raw.replace("```json", "").replace("```", "").strip()

        # Find JSON boundaries
        start = raw.find("{")
        end = raw.rfind("}") + 1
        if start == -1 or end <= start:
            log.warning("No JSON found in response")
            return None

        data = json.loads(raw[start:end])

        # Validate required keys
        required = ["transcript", "customer_text", "issue_title", "summary", "sentiment"]
        for key in required:
            if key not in data:
                log.warning("Missing key '%s' in response", key)
                return None

        # Add metadata
        data["generated_language_variant"] = language
        data["target_issue_category"] = issue

        return data

    except ollama.ResponseError as e:
        log.error("Ollama not running: %s", e)
        log.error("Make sure: ollama serve && ollama pull %s", OLLAMA_MODEL)
        raise
    except json.JSONDecodeError as e:
        log.warning("JSON parse failed: %s", e)
        return None
    except Exception as e:
        log.warning("Unexpected error: %s", e)
        return None


def format_for_finetune(sample: dict) -> dict:
    """
    Convert raw sample into the instruction-following format
    that Unsloth/Llama fine-tuning expects (Alpaca format).
    """
    customer_text = sample.get("customer_text", "")
    full_transcript = "\n".join(
        f"{t['role']}: {t['text']}" for t in sample.get("transcript", [])
    )

    instruction = (
        "You are a CRM analyst. Analyze this customer support call and extract: "
        "issue_title (5-8 words), summary (2-3 sentences), sentiment (positive/neutral/negative), "
        "resolution (resolved/unresolved/escalated)."
    )
    input_text = f"Call Transcript:\n{full_transcript}\n\nCustomer said:\n{customer_text}"
    output = json.dumps({
        "issue_title": sample.get("issue_title", ""),
        "summary": sample.get("summary", ""),
        "sentiment": sample.get("sentiment", "neutral"),
        "resolution": sample.get("resolution", "unresolved"),
    }, ensure_ascii=False)

    return {
        "instruction": instruction,
        "input": input_text,
        "output": output,
        # Keep raw data too for reference
        "_raw": sample,
    }


def generate_dataset(n_samples: int, output_path: Path):
    output_path.parent.mkdir(parents=True, exist_ok=True)

    samples_per_language = max(1, n_samples // len(LANGUAGE_VARIANTS))
    log.info("Generating ~%d samples per language variant (%d total)", samples_per_language, n_samples)

    generated = 0
    failed = 0

    with open(output_path, "w", encoding="utf-8") as f:
        for language in LANGUAGE_VARIANTS:
            log.info("─── Language: %s ───", language)
            for i in range(samples_per_language):
                issue = random.choice(ISSUE_CATEGORIES)
                sentiment = pick_sentiment()

                log.info("[%s] Sample %d/%d | Issue: %s | Sentiment: %s",
                         language[:20], i + 1, samples_per_language, issue, sentiment)

                sample = generate_one_sample(language, issue, sentiment)

                if sample:
                    ft_sample = format_for_finetune(sample)
                    f.write(json.dumps(ft_sample, ensure_ascii=False) + "\n")
                    generated += 1
                    log.info("  ✓ Generated: '%s'", sample.get("issue_title", "?")[:50])
                else:
                    failed += 1
                    log.warning("  ✗ Failed — skipping")

                # Small delay to avoid overwhelming Ollama
                time.sleep(0.5)

    log.info("═══════════════════════════════════════")
    log.info("Done! Generated: %d  |  Failed: %d", generated, failed)
    log.info("Output saved to: %s", output_path)
    log.info("═══════════════════════════════════════")

    # Print quick stats
    print_stats(output_path)


def print_stats(path: Path):
    if not path.exists():
        return
    samples = []
    with open(path, encoding="utf-8") as f:
        for line in f:
            try:
                samples.append(json.loads(line))
            except Exception:
                continue

    lang_counts: dict[str, int] = {}
    sentiment_counts: dict[str, int] = {}

    for s in samples:
        raw = s.get("_raw", {})
        lang = raw.get("generated_language_variant", "unknown")
        sent = raw.get("sentiment", "unknown")
        lang_counts[lang] = lang_counts.get(lang, 0) + 1
        sentiment_counts[sent] = sentiment_counts.get(sent, 0) + 1

    print("\n📊 Dataset Statistics:")
    print(f"   Total samples: {len(samples)}")
    print("\n   By language:")
    for lang, count in lang_counts.items():
        print(f"     {lang[:45]:<45} {count:>4} samples")
    print("\n   By sentiment:")
    for sent, count in sentiment_counts.items():
        print(f"     {sent:<12} {count:>4} samples")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Generate synthetic multilingual call data")
    parser.add_argument("--samples", type=int, default=120,
                        help="Total number of samples to generate (default: 120)")
    parser.add_argument("--output", type=str, default="data/train.jsonl",
                        help="Output JSONL file path (default: data/train.jsonl)")
    parser.add_argument("--model", type=str, default=OLLAMA_MODEL,
                        help=f"Ollama model to use (default: {OLLAMA_MODEL})")
    args = parser.parse_args()

    OLLAMA_MODEL = args.model

    generate_dataset(
        n_samples=args.samples,
        output_path=Path(args.output),
    )